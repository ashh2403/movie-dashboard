	partition Movies = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(DataUrl), [Delimiter = ",", Columns = {"Movie Title", "Genre", "Release Year", "Revenue", "Rating Score", "Director", "Star", "Budget", "Votes", "Runtime", "Country", "Company", "Released", "Writer", "Certificate"}, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Removed Header Row" = Table.Skip(Source, 1),
				    #"Trimmed Text" = Table.TransformColumns(#"Removed Header Row", {{"Movie Title", Text.Trim, type text}, {"Genre", Text.Trim, type text}, {"Director", Text.Trim, type text}, {"Star", Text.Trim, type text}, {"Country", Text.Trim, type text}, {"Company", Text.Trim, type text}, {"Released", Text.Trim, type text}, {"Writer", Text.Trim, type text}, {"Certificate", Text.Trim, type text}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Trimmed Text", {{"Release Year", Int64.Type}, {"Revenue", Int64.Type}, {"Rating Score", type number}, {"Budget", Int64.Type}, {"Votes", Int64.Type}, {"Runtime", Int64.Type}}, "en-US"),
				    #"Merged Unrated" = Table.ReplaceValue(#"Changed Type", "Unrated", "Not Rated", Replacer.ReplaceValue, {"Certificate"}),
				    #"Added Profit" = Table.AddColumn(#"Merged Unrated", "Profit", each [Revenue] - [Budget], Int64.Type),
				    #"Added Decade" = Table.AddColumn(#"Added Profit", "Decade", each Text.From(Number.IntegerDivide([Release Year], 10) * 10) & "s", type text)
				in
				    #"Added Decade"

	annotation PBI_ResultType = Table
