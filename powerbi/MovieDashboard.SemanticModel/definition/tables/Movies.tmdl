table Movies
	lineageTag: b65469b7-c04e-55db-b002-1c9e3c6734f8

	measure 'Total Movies' = COUNTROWS(Movies)
		formatString: #,0
		lineageTag: 480f3d12-5b1a-53b2-86c1-5b91d5bccb0b

	measure 'Total Revenue' = SUM(Movies[Revenue])
		formatString: #,0
		lineageTag: 9d10b07b-7193-5b30-a2f4-261f58a0b8b1

	measure 'Total Budget' = SUM(Movies[Budget])
		formatString: #,0
		lineageTag: 4a98b2cb-9734-5894-86a2-b769ad6dcd39

	measure 'Total Profit' = [Total Revenue] - [Total Budget]
		formatString: #,0
		lineageTag: 86994c39-738a-5a9d-a98c-2f72fee6ee83

	measure 'Sum of Rating Score' = SUM(Movies[Rating Score])
		formatString: #,0.0
		lineageTag: 75b77be9-f5ed-559d-b05e-01695f9f4c02

	measure 'Average Rating' = AVERAGE(Movies[Rating Score])
		formatString: 0.00
		lineageTag: fe5bfd05-461b-5b52-83d2-519d5745b18e

	measure 'Average Revenue' = AVERAGE(Movies[Revenue])
		formatString: #,0
		lineageTag: a6a0008f-91b2-5c3a-a0c9-0df1212e9744

	measure 'Revenue per Budget' = DIVIDE([Total Revenue], [Total Budget])
		formatString: 0.00"x"
		lineageTag: 6e014d78-0c11-5a3a-862f-e9f3bd873c4e

	measure 'Median ROI' = MEDIANX(FILTER(Movies, Movies[Budget] > 0), DIVIDE(Movies[Revenue] - Movies[Budget], Movies[Budget]))
		formatString: 0%
		lineageTag: 8939d97f-3108-54bd-90f2-4ab0302aada2

	measure 'Average Revenue (10+ movies)' = IF([Total Movies] >= 10, [Average Revenue])
		formatString: #,0
		lineageTag: b3d61ac8-fd5b-5cf0-8010-ce8ac0c4ebbe

	measure 'Average Rating (10+ movies)' = IF([Total Movies] >= 10, [Average Rating])
		formatString: 0.00
		lineageTag: fe03a77c-0e4b-5903-b15b-6f1fe869380a

	measure 'Average Rating (5+ movies)' = IF([Total Movies] >= 5, [Average Rating])
		formatString: 0.00
		lineageTag: 06f9a1f9-f15c-5dce-b7c7-60205f05edef

	measure 'Median ROI (10+ movies)' = IF([Total Movies] >= 10, [Median ROI])
		formatString: 0%
		lineageTag: aa000e4a-6c1e-5df4-9415-f40c57d2d8e3

